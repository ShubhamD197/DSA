https://leetcode.com/problems/count-good-numbers/description/
A digit string is good if the digits (0-indexed) at even indices are even and the digits at odd indices are prime (2, 3, 5, or 7).

For example, "2582" is good because the digits (2 and 8) at even positions are even and the digits (5 and 2) at odd positions are prime. However, "3245" is not good because 3 is at an even index but is not even.
Given an integer n, return the total number of good digit strings of length n. Since the answer may be large, return it modulo 109 + 7.

A digit string is a string consisting of digits 0 through 9 that may contain leading zeros.

Example 1:

Input: n = 1
Output: 5
Explanation: The good numbers of length 1 are "0", "2", "4", "6", "8".
Example 2:

Input: n = 4
Output: 400
Example 3:

Input: n = 50
Output: 564908303
 
Constraints:
1 <= n <= 1015
int M = 1_000_000_007;

=================================================Solution 1=============================================================
Time complexity = O(log n)
space complexity = O(log n) because we are using recursion stack for each iteration n = n / 2

class Solution {
    int M = 1_000_000_007;

    public int countGoodNumbers(long n) {
        long even = (n + 1)/2;
        long odd = n / 2;

        long result = (pow(5, even) * pow(4, odd)) % M;
        return (int) result;    
    }

    private long pow(long a, long b){
        if(b == 0) return 1;

        long half = pow(a, b / 2);
        long ans = (half * half) % M;

        if(b % 2 == 1){
            ans = (ans * a) % M;
        }

        return ans;
    }
}

=================================================Solution 2 (Optimised by space complexity)==============================================================
Time complexity = O(log n)
space complexity = O(1) because we are using while loop there is no recursion stack is used

class Solution {
    int M = 1_000_000_007;

    public int countGoodNumbers(long n) {
        long even = (n + 1) / 2;
        long odd = n / 2;

        long result = (pow(5, even) * pow(4, odd)) % M;
        return (int) result;
    }

    private long pow(long x, long n) {
        long ans = 1;

        while (n > 0) {

            if (n % 2 == 1) { 
                ans = (ans * x) % M;
            }

            x = (x * x) % M;
            n = n / 2; 
        }

        return ans;
    }
}
